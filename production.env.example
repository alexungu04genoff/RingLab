# Copy to production.env on the VPS only. chmod 600; never commit real values.
# Values are placeholders, not usable credentials. Use a hex database password.
BACKEND_IMAGE=ghcr.io/OWNER/ringlab-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/OWNER/ringlab-frontend:COMMIT_SHA
DB_USER=REPLACE_WITH_PRODUCTION_USER
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
GOOGLE_CLIENT_ID=REPLACE_WITH_EXISTING_CLIENT_ID
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=REPLACE_WITH_IMPLICIT_TLS_PORT
SMTP_USERNAME=REPLACE_WITH_SMTP_LOGIN
SMTP_PASSWORD=REPLACE_WITH_SMTP_KEY
SMTP_TLS=true
# SMTP values are read literally (no quotes, no inline comments, no $ expansion).
# Optional rate limits use the existing RATE_LIMIT_* names and defaults.
